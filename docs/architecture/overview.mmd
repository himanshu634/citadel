graph TB
  subgraph PEOPLE["People"]
    direction LR
    EXT["Any AI agent<br/>Claude, IDE, Slack bot"]
    LEAD["CEO · Tech lead<br/>asks questions,<br/>approves new facts"]
  end

  SRC["Company sources<br/>GitHub · Linear · Docs · Slack · Jira"]

  subgraph CORE["Company Brain"]
    direction LR
    TOOLS["Named graph tools<br/>and MCP server<br/>no LLM-written Cypher"]
    BRAIN[("THE BRAIN<br/>FalkorDB graph<br/>one per company")]
    CUR["BRAIN CURATOR<br/>finds gaps, consults,<br/>verifies, writes"]
  end

  BOARD["Shared work board, inside the graph<br/>consult tasks · cited claims · decisions"]

  subgraph TEAM["Role agents: they talk through the board"]
    direction LR
    PM["PM"]
    DES["Designer"]
    QA["QA"]
    DEV["Developer"]
    OPS["DevOps"]
    REV["Reviewer · Risk"]
  end

  LEAD -->|"ask"| TOOLS
  TOOLS -->|"answer + sources + graph path"| LEAD
  EXT -->|"MCP"| TOOLS
  SRC -->|"ingest"| BRAIN
  TOOLS <-->|"read"| BRAIN
  TOOLS -->|"unknown or stale"| CUR
  CUR -->|"confirm new fact?"| LEAD
  CUR -->|"post consults"| BOARD
  BOARD -->|"cited claims"| CUR
  CUR ==>|"verified knowledge"| BRAIN
  PM <--> BOARD
  DES <--> BOARD
  QA <--> BOARD
  DEV <--> BOARD
  OPS <--> BOARD
  REV <--> BOARD

  classDef brain fill:#e0f2fe,stroke:#0369a1,stroke-width:3px
  classDef curator fill:#fff7ed,stroke:#d97706,stroke-width:3px
  classDef agent fill:#f0fdf4,stroke:#15803d,stroke-width:1px
  classDef person fill:#faf5ff,stroke:#7e22ce,stroke-width:1px
  classDef source fill:#f8fafc,stroke:#94a3b8
  classDef planned stroke-dasharray: 6 4
  class BRAIN,TOOLS brain
  class CUR curator
  class PM,DES,QA,DEV,OPS,REV,BOARD agent
  class LEAD,EXT person
  class SRC source
  class CUR,DES planned
