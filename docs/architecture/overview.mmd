graph TB
  subgraph PEOPLE["People"]
    direction LR
    EXT["Any AI agent<br/>Claude, IDE, Slack bot"]
    LEAD["CEO · Tech lead<br/>asks questions,<br/>approves critical updates"]
  end

  SRC["Company sources<br/>GitHub · Linear · Docs · Slack · Jira"]
  UI["Systems page, planned<br/>agent trail, Review now,<br/>approvals, Keeper log"]

  subgraph CORE["Company Brain"]
    direction LR
    MCP["MCP server, planned<br/>the same tools<br/>for outside agents"]
    TOOLS["Named graph tools<br/>17 Cypher files<br/>no LLM-written Cypher"]
    BRAIN[("THE BRAIN<br/>FalkorDB graph per company<br/>sources and Keeper claims")]
  end

  subgraph AGENTS["Agents: they talk through the ledger, never to each other"]
    direction LR
    ASK["brain<br/>answers questions (Ask)"]
    KEEP["KEEPER<br/>reviews gaps, decides,<br/>the only writer of knowledge"]
    PM["pm<br/>answers consults,<br/>opens follow-ups"]
    QA["qa<br/>answers consults"]
  end

  LEDGER[("KEEPER LEDGER<br/>keeper_slug: gaps · consults<br/>claims · follow-ups · log")]

  LEAD -->|"ask; answer with sources and graph path"| ASK
  LEAD -->|"approve or reject critical claims"| KEEP
  LEAD -.-> UI
  UI -.-> LEDGER
  EXT -.->|"MCP"| MCP
  ASK -->|"read"| TOOLS
  MCP -.-> TOOLS
  TOOLS -->|"read"| BRAIN
  ASK -->|"failed turn, thumbs down: gap"| LEDGER
  KEEP -->|"picks gaps, posts consults, writes claims"| LEDGER
  PM <--> LEDGER
  QA <--> LEDGER
  KEEP ==>|"accepted claims, projected"| BRAIN
  SRC -->|"ingest, sources win"| BRAIN

  classDef brain fill:#e0f2fe,stroke:#0369a1,stroke-width:3px
  classDef keeper fill:#fff7ed,stroke:#d97706,stroke-width:3px
  classDef agent fill:#f0fdf4,stroke:#15803d,stroke-width:1px
  classDef person fill:#faf5ff,stroke:#7e22ce,stroke-width:1px
  classDef source fill:#f8fafc,stroke:#94a3b8
  classDef planned stroke-dasharray: 6 4
  class BRAIN,TOOLS,MCP brain
  class KEEP,LEDGER keeper
  class ASK,PM,QA agent
  class LEAD,EXT person
  class SRC,UI source
  class MCP,UI planned
