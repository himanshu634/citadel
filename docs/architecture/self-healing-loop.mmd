graph TD
  Q["Lead asks a question"]
  ANS{"brain answers,<br/>citing a source?"}
  OK["Answer with sources<br/>and graph path"]
  NOTICE["After a build<br/>re-check accepted claims,<br/>notice stale owners and<br/>unowned busy systems"]
  GAP["Gap on the ledger<br/>keeper_slug, a repeat<br/>bumps its count"]
  PICK["Keeper review run<br/>top gaps: 5 on Review now,<br/>3 after a build"]
  CONSULT["pm and qa consulted<br/>a draft claim citing uids,<br/>or cannot ground it"]
  DECIDE{"Keeper decides"}
  PERSON["Needs a person<br/>left visible"]
  DISMISS["Dismissed<br/>the gap was noise"]
  EVID{"Evidence uids<br/>exist in the brain?"}
  REJ["Claim rejected and kept.<br/>Its gap reopens; after 2<br/>rejections it needs a person"]
  SRCW{"Contradicts<br/>the sources?"}
  CONF["conflicts_with_source<br/>sources win:<br/>never projected"]
  FIX["pm follow-up<br/>fix the source"]
  CRIT{"Critical?<br/>replaces a claim,<br/>high-impact system,<br/>no source evidence"}
  LEAD{"Lead approves?"}
  ACC["Claim accepted<br/>projected into brain_slug<br/>with ABOUT and EVIDENCE"]
  OLD["Earlier claim superseded<br/>valid_to set, never deleted"]
  FU["pm follow-up<br/>owner, expert or<br/>decision claim"]
  REASK["Asked again<br/>Ask cites the claim<br/>through keeper_notes"]

  Q --> ANS
  ANS -->|yes| OK
  ANS -->|"no answer or no source"| GAP
  OK -->|"thumbs down"| GAP
  NOTICE --> GAP
  GAP --> PICK
  PICK --> CONSULT
  CONSULT --> DECIDE
  DECIDE -->|"nobody can ground it"| PERSON
  DECIDE -->|noise| DISMISS
  DECIDE -->|claim| EVID
  EVID -->|no| REJ
  EVID -->|yes| SRCW
  SRCW -->|yes| CONF
  CONF --> FIX
  SRCW -->|no| CRIT
  CRIT -->|"no: auto"| ACC
  CRIT -->|yes| LEAD
  LEAD -->|no| REJ
  LEAD -->|yes| ACC
  ACC --> OLD
  ACC --> FU
  ACC --> REASK
  REASK --> ANS

  classDef keeper fill:#fff7ed,stroke:#d97706,stroke-width:3px
  classDef brain fill:#e0f2fe,stroke:#0369a1,stroke-width:2px
  classDef agent fill:#f0fdf4,stroke:#15803d
  classDef person fill:#faf5ff,stroke:#7e22ce
  classDef thin fill:#f8fafc,stroke:#94a3b8
  class PICK,DECIDE,EVID,SRCW,CRIT keeper
  class ANS,OK,ACC,OLD,REASK brain
  class CONSULT,FIX,FU agent
  class Q,LEAD person
  class GAP,NOTICE,PERSON,DISMISS,REJ,CONF thin
