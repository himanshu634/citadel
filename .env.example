# Copy to .env. The same code runs against local Docker or FalkorDB Cloud: only these values change.

# FalkorDB. docker-compose.yml reads the same values, so `make up` starts a container that matches
# them. For FalkorDB Cloud, set host/port/username/password from the console instead.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
# Empty = no auth on the local container. Set one and `make up` turns on requirepass.
FALKORDB_PASSWORD=
# true for a FalkorDB Cloud instance with TLS enabled (Startup tier and up)
FALKORDB_TLS=false
# Local container only: FalkorDB Browser UI port and image tag.
FALKORDB_BROWSER_PORT=3000
FALKORDB_IMAGE_TAG=latest

# Port for `make api` (default 8000). Not read from this file: override with
# `make api API_PORT=9000` or an exported API_PORT.

# GitHub (read-only token is enough). If empty, `gh auth token` is used as a fallback.
GITHUB_TOKEN=

# Linear personal API key (Linear -> Settings -> Security & access). Only needed for `linear`
# sources and `make linear-seed`.
LINEAR_API_KEY=

# Claude (Anthropic API) answers questions over the graph: `agents ask`. If the key is empty,
# the SDK falls back to ANTHROPIC_* env vars or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Haiku while we figure out what to build; claude-sonnet-5-5 or claude-opus-5-5 for better
# answers (those two also get server-side refusal fallbacks; Haiku has none).
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. For claude-opus-5-5 use high.
ANTHROPIC_EFFORT=medium
# Tokens for a company's MCP servers go here under the name its `token_env:` gives, e.g.
# HANDBOOK_MCP_TOKEN=

# The Keeper (`agents keeper review`, `POST .../keeper/review` and the review after a build). Its
# review runs LLM jobs only with an ANTHROPIC_API_KEY here or in the environment; without one a
# review only re-projects claims and notices gaps, and is recorded as skipped.
# On-demand review budget: gaps one on-demand review (CLI or API) decides.
# KEEPER_BUDGET=5
# After-build review budget: gaps the review the app starts after a build decides.
# KEEPER_BUILD_BUDGET=3
# Max new gaps per noticing run.
# KEEPER_NOTICE_CAP=10

# Vector index size on Chunk.embedding. Must equal the output size of EMBEDDING_MODEL below.
EMBEDDING_DIM=768
# fastembed: embed Chunk text on this machine (the model downloads once into data/models; no
# text leaves it). gemini: Google's Gemini embedding API with GEMINI_API_KEY (chunk text and
# questions go to Google; no model in memory). none: off. After changing provider or model,
# run make embed: chunks from another model are embedded again.
EMBEDDING_PROVIDER=fastembed
# Empty: the provider's default, BAAI/bge-base-en-v1.5 (fastembed, 768) or gemini-embedding-2
# (gemini, asked for EMBEDDING_DIM values; 768, 1536 or 3072 recommended). Its output size must
# equal EMBEDDING_DIM.
EMBEDDING_MODEL=
# For EMBEDDING_PROVIDER=gemini: a Gemini API key (aistudio.google.com) whose project has billing
# (the paid tier, which credits pay for; free-tier text may be used by Google).
GEMINI_API_KEY=
