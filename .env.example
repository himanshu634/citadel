# Copy to .env. The same code runs against local Docker or FalkorDB Cloud: only these values change.

# FalkorDB (local docker compose defaults; for Cloud, set host/port/username/password from the console)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# true for a FalkorDB Cloud instance with TLS enabled (Startup tier and up)
FALKORDB_TLS=false

# Port for `make api` (default 8000). Not read from this file: override with
# `make api API_PORT=9000` or an exported API_PORT.

# GitHub (read-only token is enough). If empty, `gh auth token` is used as a fallback.
GITHUB_TOKEN=

# Claude (Anthropic API) answers questions over the graph: `brain ask`. If the key is empty,
# the SDK falls back to ANTHROPIC_* env vars or an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Haiku while we figure out what to build; claude-sonnet-5-5 or claude-opus-5-5 for better
# answers (those two also get server-side refusal fallbacks; Haiku has none).
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. For claude-opus-5-5 use high.
ANTHROPIC_EFFORT=medium

# Vertex AI embeddings (used in a later step)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-005
# Must match the embedding model's output size; the vector index is created with this dimension.
EMBEDDING_DIM=768
